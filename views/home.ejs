<% const noContainer = true; %>

<!-- Hero Section -->
<section class="hero">
    <h1>أرشيف الفلكلور المصري</h1>
    <p>
        مرحباً بك في المنصة الرقمية لمركز دراسات الفنون الشعبية. يهدف هذا الأرشيف إلى توثيق وحفظ
        التراث الفلكلوري المصري بكافة أشكاله — من المواويل والأغاني الشعبية إلى الحرف التقليدية
        والرقصات والموروثات الثقافية — لتظل حاضرة للأجيال القادمة.
    </p>
    <div class="hero-actions">
        <a href="/folklore" class="btn btn-primary"><i class="fa-solid fa-plus"></i> إضافة مادة جديدة</a>
        <a href="/archive" class="btn btn-outline">تصفح الأرشيف</a>
    </div>
</section>

<!-- About Section -->
<section class="about-section">
    <div class="about-content">
        <h2><i class="fa-solid fa-building-columns"></i> عن المشروع</h2>
        <p>
            يُعدّ مركز دراسات الفنون الشعبية أحد أبرز المراكز البحثية المعنية بالتراث الشعبي المصري.
            يعمل المركز منذ عقود على جمع وتوثيق المواد الفلكلورية من مختلف محافظات مصر، 
            من خلال بعثات ميدانية متخصصة تتواصل مع الرواة والممارسين لتسجيل وحفظ هذا التراث الغني.
        </p>
        <p>
            يضم الأرشيف الرقمي خمسة تصنيفات رئيسية تغطي أبرز مجالات التراث الشعبي المصري: 
            الأدب الشعبي، العادات والتقاليد، المعتقدات والمعارف الشعبية، الفنون الشعبية، والثقافة المادية. 
            ويهدف المشروع إلى إتاحة هذه المواد للباحثين والمهتمين بالتراث المصري في بيئة رقمية منظمة وسهلة الاستخدام.
        </p>
    </div>
</section>


<!-- Stats Section -->
<section class="stats-section">
    <div class="stats-grid container">
        <div class="stat-card">
            <span class="stat-icon"><i class="fa-solid fa-file-lines"></i></span>
            <span class="stat-number"><%= stats.totalMaterials %></span>
            <span class="stat-label">مادة ميدانية</span>
        </div>
        <div class="stat-card">
            <span class="stat-icon"><i class="fa-solid fa-folder-open"></i></span>
            <span class="stat-number"><%= stats.totalCategories %></span>
            <span class="stat-label">تصنيف رئيسي</span>
        </div>
        <div class="stat-card">
            <span class="stat-icon"><i class="fa-solid fa-microphone-lines"></i></span>
            <span class="stat-number"><%= stats.totalNarrators %></span>
            <span class="stat-label">راوي</span>
        </div>
        <div class="stat-card">
            <span class="stat-icon"><i class="fa-solid fa-map"></i></span>
            <span class="stat-number"><%= stats.totalMissions %></span>
            <span class="stat-label">بعثة ميدانية</span>
        </div>
    </div>
</section>



<!-- Categories Section -->
<section class="categories-section">
    <div class="container">
        <div class="section-header">
            <h2>التصنيفات الرئيسية</h2>
            <p>اضغط على أي تصنيف لاستعراض المواد الفلكلورية التابعة له</p>
        </div>
        <div class="categories-grid">
            <% categories.forEach(cat => { %>
            <div class="category-card modern-card">
                <div class="card-front">
                    <span class="category-icon"><%- cat.icon || '<i class="fa-solid fa-folder"></i>' %></span>
                    <h3><%= cat.name %></h3>
                    <p><%= cat.description || '' %></p>
                    <span class="category-count"><%= cat.elementCount || 0 %> عنصر</span>
                </div>
                <div class="card-overlay">
                    <h4>مكونات التصنيف</h4>
                    <ul class="overlay-elements-list">
                        <% if (cat.elementsList && cat.elementsList.length > 0) { %>
                            <% cat.elementsList.forEach(el => { %>
                                <li><%- el.icon %> <%= el.name %></li>
                            <% }); %>
                        <% } else { %>
                            <li>لا توجد عناصر مضافة</li>
                        <% } %>
                    </ul>
                    <a href="/archive?category=<%= cat._id %>" class="btn btn-outline btn-sm">تصفح الأرشيف</a>
                </div>
            </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- Recent Items Section -->
<section class="recent-section">
    <div class="container">
        <div class="section-header">
            <h2><i class="fa-regular fa-clock"></i> آخر المواد المضافة</h2>
            <p>أحدث المواد الفلكلورية التي تم توثيقها في الأرشيف</p>
        </div>

        <% if (recentItems.length === 0) { %>
        <div class="empty-state">
            <div class="empty-icon"><i class="fa-regular fa-folder-open"></i></div>
            <h3>لا توجد مواد بعد</h3>
            <p>ابدأ بإضافة أول مادة فلكلورية للأرشيف</p>
            <a href="/folklore" class="btn btn-primary" style="margin-top: 16px;"><i class="fa-solid fa-plus"></i> إضافة مادة جديدة</a>
        </div>
        <% } else { %>
        <div class="items-grid">
            <% recentItems.forEach(item => { %>
            <div class="item-card">
                <span class="item-type type-<%= item.type %>"><%- item.typeLabel %></span>
                <h3><%= item.name %></h3>
                <div class="item-meta">
                    <% if (item.narrator) { %>
                    <span><i class="fa-solid fa-microphone-lines"></i> <%= item.narrator %></span>
                    <% } %>
                    <% if (item.date) { %>
                    <span><i class="fa-regular fa-calendar-days"></i> <%= new Date(item.date).toLocaleDateString('ar-EG') %></span>
                    <% } %>
                </div>
                <a href="/archive/<%= item.type %>/<%= item.id %>" class="btn-details">
                    عرض التفاصيل <i class="fa-solid fa-arrow-left"></i>
                </a>
            </div>
            <% }); %>
        </div>
        <% } %>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('success')) {
            Swal.fire({
                title: 'تم بنجاح!',
                text: 'تم حفظ جميع البيانات التفصيلية في الأرشيف بنجاح.',
                icon: 'success',
                confirmButtonText: 'حسناً',
                confirmButtonColor: '#1d3557'
            }).then(() => {
                // إزالة المتغير من الرابط لتجنب ظهور الرسالة مرة أخرى عند التحديث
                window.history.replaceState(null, '', window.location.pathname);
            });
        }
    });
</script>

<style>
.modern-card {
    position: relative;
    overflow: hidden;
    padding: 0 !important;
}

.card-front {
    padding: 30px 24px;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: 0.3s;
}

.modern-card:hover .card-front {
    transform: translateY(-20px);
    opacity: 0;
}

.card-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(26, 82, 118, 0.95); /* Primary color with opacity */
    color: white;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(20px);
    transition: 0.4s ease;
    padding: 20px;
    border-radius: var(--radius-md);
}

.modern-card:hover .card-overlay {
    opacity: 1;
    transform: translateY(0);
}

.card-overlay h4 {
    font-size: 1.1rem;
    margin-bottom: 12px;
    color: var(--color-accent-light);
    border-bottom: 1px solid rgba(255,255,255,0.2);
    padding-bottom: 5px;
}

.overlay-elements-list {
    list-style: none;
    padding: 0;
    margin: 0 0 15px 0;
    width: 100%;
    text-align: center;
}

.overlay-elements-list li {
    font-size: 0.95rem;
    padding: 6px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-bottom: 1px dashed rgba(255,255,255,0.15);
}

.overlay-elements-list li:last-child {
    border-bottom: none;
}
</style>

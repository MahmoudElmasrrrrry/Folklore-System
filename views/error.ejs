<div class="error-page">
    <div class="error-code"><%= typeof statusCode !== 'undefined' ? statusCode : 500 %></div>
    <h2><%= typeof title !== 'undefined' ? title : 'حدث خطأ' %></h2>
    <p><%= typeof message !== 'undefined' ? message : 'عذراً، حدث خطأ غير متوقع.' %></p>
    <a href="/" class="btn btn-primary">← العودة للرئيسية</a>
</div>

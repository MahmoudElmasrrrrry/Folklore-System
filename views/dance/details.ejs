<div class="details-header">
    <div class="container">
        <div class="meta-tags">
            <span class="badge"><i class="fa-solid fa-person-dress"></i> رقصة شعبية</span>
            <span class="badge"><i class="fa-regular fa-calendar-days"></i>
                <%= new Date(dance.createdAt).toLocaleDateString('ar-EG', { year: 'numeric' , month: 'long' ,
                    day: 'numeric' }) %>
            </span>
            <% if (dance.folkloreMaterial && dance.folkloreMaterial.category) { %>
                <span class="badge"><i class="fa-solid fa-folder"></i>
                    <%= dance.folkloreMaterial.category.name %>
                </span>
            <% } %>
        </div>

        <h1><%= dance.danceName %></h1>

        <% if (dance.music && dance.music.audioUrl) { %>
            <div class="hero-audio">
                <audio controls preload="metadata">
                    <source src="<%= dance.music.audioUrl %>" type="audio/mpeg">
                    متصفحك لا يدعم مشغل الصوت.
                </audio>
            </div>
        <% } %>
        
        <% if (dance.music && dance.music.lyricsFileUrl) { %>
            <div style="margin-top: 20px; text-align: center;">
                <a href="<%= dance.music.lyricsFileUrl %>" target="_blank" class="btn" style="background: rgba(255,255,255,0.2); color: white; border-radius: 25px; padding: 10px 25px; font-size: 1.1rem; text-decoration: none; display: inline-flex; align-items: center; gap: 10px; backdrop-filter: blur(5px); border: 1px solid rgba(255,255,255,0.3); transition: all 0.3s ease;">
                    <i class="fa-solid fa-file-lines"></i> عرض ملف الكلمات (Lyrics)
                </a>
            </div>
        <% } %>
    </div>
</div>

<div class="container" style="margin-top: 40px; margin-bottom: 60px;">
    <div class="details-grid">

        <!-- المحتوى الرئيسي (يمين) -->
        <div class="main-content">

            <!-- الوصف والفيديو الأساسي -->
            <% if ((dance.description && dance.description.text) || dance.description?.videoUrl) { %>
                <div class="content-section">
                    <h2><i class="fa-solid fa-align-right"></i> الوصف الحركي للرقصة</h2>
                    
                    <% if (dance.description?.videoUrl) { %>
                        <div class="main-video-container">
                            <video controls>
                                <source src="<%= dance.description.videoUrl %>" type="video/mp4">
                                متصفحك لا يدعم مشغل الفيديو.
                            </video>
                        </div>
                    <% } %>

                    <% if (dance.description && dance.description.text) { %>
                        <div class="text-block">
                            <p><%= dance.description.text %></p>
                        </div>
                    <% } %>
                </div>
            <% } %>

            <!-- معرض الصور -->
            <% if (dance.description?.images && dance.description.images.length > 0) { %>
                <div class="content-section">
                    <h2><i class="fa-solid fa-images"></i> صور مرتبطة</h2>
                    <div class="gallery-grid">
                        <% dance.description.images.forEach(img => { %>
                            <div class="gallery-item">
                                <img src="<%= img %>" alt="صورة الرقصة">
                            </div>
                        <% }) %>
                    </div>
                </div>
            <% } %>

            <!-- تفاصيل الرقصة والموسيقى -->
            <div class="content-section">
                <h2><i class="fa-solid fa-info-circle"></i> بيانات الرقصة والموسيقى</h2>
                <div class="data-grid">
                    <% if(dance.occasion) { %>
                        <div class="data-item"><span>المناسبة</span><strong><%= dance.occasion %></strong></div>
                    <% } %>
                    <% if(dance.presentationStyle) { %>
                        <div class="data-item"><span>أسلوب التقديم</span><strong><%= dance.presentationStyle %></strong></div>
                    <% } %>
                    <% if(dance.mediumType) { %>
                        <div class="data-item"><span>نوع الوسيط</span><strong><%= dance.mediumType %></strong></div>
                    <% } %>
                    <% if(dance.music && dance.music.accompanimentType) { %>
                        <div class="data-item"><span>المصاحبة الموسيقية</span><strong><%= dance.music.accompanimentType %></strong></div>
                    <% } %>
                    <% if(dance.music && dance.music.songName) { %>
                        <div class="data-item"><span>الأغنية</span><strong><%= dance.music.songName %></strong></div>
                    <% } %>
                </div>
            </div>

            <!-- الأزياء -->
            <% if ((dance.costumes?.women?.name) || (dance.costumes?.men?.name)) { %>
            <div class="content-section">
                <h2><i class="fa-solid fa-shirt"></i> الأزياء المرتبطة</h2>
                <div class="costumes-container">
                    <% if(dance.costumes?.women?.name) { %>
                        <div class="costume-card">
                            <div class="costume-header women">زي النساء</div>
                            <% if(dance.costumes.women.image) { %>
                                <div class="costume-image">
                                    <img src="<%= dance.costumes.women.image %>" alt="زي النساء">
                                </div>
                            <% } %>
                            <div class="costume-body">
                                <h3><%= dance.costumes.women.name %></h3>
                                <p><%= dance.costumes.women.description %></p>
                            </div>
                        </div>
                    <% } %>
                    
                    <% if(dance.costumes?.men?.name) { %>
                        <div class="costume-card">
                            <div class="costume-header men">زي الرجال</div>
                            <% if(dance.costumes.men.image) { %>
                                <div class="costume-image">
                                    <img src="<%= dance.costumes.men.image %>" alt="زي الرجال">
                                </div>
                            <% } %>
                            <div class="costume-body">
                                <h3><%= dance.costumes.men.name %></h3>
                                <p><%= dance.costumes.men.description %></p>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
            <% } %>

            <!-- المؤدون -->
            <% if (dance.performers && dance.performers.length > 0) { %>
            <div class="content-section">
                <h2>
                    <i class="fa-solid fa-users"></i> المؤدون 
                    <span class="count-badge"><%= dance.performersCount || dance.performers.length %></span>
                </h2>
                <div class="performers-list">
                    <% dance.performers.forEach((p, index) => { %>
                        <div class="performer-card">
                            <div class="performer-avatar">
                                <% if(p.gender === 'نساء') { %>
                                    <i class="fa-solid fa-person-dress" style="color: #e63946;"></i>
                                <% } else if(p.gender === 'رجال') { %>
                                    <i class="fa-solid fa-person" style="color: #1d3557;"></i>
                                <% } else { %>
                                    <i class="fa-solid fa-child" style="color: #457b9d;"></i>
                                <% } %>
                            </div>
                            <div class="performer-details">
                                <h4>مؤدي رقم <%= index + 1 %> <span class="gender-tag"><%= p.gender || 'غير محدد' %></span></h4>
                                <div class="performer-meta">
                                    <span><i class="fa-regular fa-id-card"></i> العمر: <%= p.age || '-' %></span>
                                    <span><i class="fa-solid fa-briefcase"></i> المهنة: <%= p.occupation || '-' %></span>
                                    <span><i class="fa-solid fa-graduation-cap"></i> التعليم: <%= p.education || '-' %></span>
                                    <span><i class="fa-solid fa-street-view"></i> التلقين: <%= p.experience?.source || '-' %></span>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
            <% } %>

            <!-- الأدوات -->
            <% if (dance.tools && dance.tools.length > 0) { %>
            <div class="content-section">
                <h2><i class="fa-solid fa-toolbox"></i> الأدوات المستخدمة</h2>
                <div class="tools-container">
                    <% dance.tools.forEach((t) => { %>
                        <div class="tool-card">
                            <% if(t.image) { %>
                                <div class="tool-image">
                                    <img src="<%= t.image %>" alt="<%= t.name %>">
                                </div>
                            <% } %>
                            <div class="tool-body">
                                <h3><%= t.name %></h3>
                                <p><%= t.description %></p>
                                <% if(t.video) { %>
                                    <a href="<%= t.video %>" target="_blank" class="btn btn-outline tool-video-btn"><i class="fa-solid fa-play"></i> مشاهدة فيديو الأداة</a>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
            <% } %>

        </div>

        <!-- القائمة الجانبية (يسار) -->
        <div class="sidebar">
            <div class="sidebar-widget">
                <h3><i class="fa-solid fa-microphone-lines"></i> بيانات الراوي / المصدر</h3>
                <% if (dance.folkloreMaterial && dance.folkloreMaterial.narrator) { %>
                    <ul class="widget-list">
                        <li><span>الاسم:</span> <strong>
                                <%= dance.folkloreMaterial.narrator.name %>
                            </strong></li>
                        <li><span>العمر:</span> <strong>
                                <%= dance.folkloreMaterial.narrator.age %> سنة
                            </strong></li>
                        <li><span>المهنة:</span> <strong>
                                <%= dance.folkloreMaterial.narrator.occupation %>
                            </strong></li>
                        <% if(dance.folkloreMaterial.narrator.status) { %>
                            <li><span>الحالة:</span> <strong>
                                    <%= dance.folkloreMaterial.narrator.status %>
                                </strong></li>
                            <% } %>
                    </ul>
                    <% } else { %>
                        <p class="text-muted">بيانات الراوي غير متوفرة</p>
                        <% } %>
            </div>

            <div class="sidebar-widget">
                <h3><i class="fa-solid fa-map-location-dot"></i> البعثة والتوثيق</h3>
                <% if (dance.folkloreMaterial) { %>
                    <ul class="widget-list">
                        <% if (dance.folkloreMaterial.mission) { %>
                            <li><span>رقم البعثة:</span> <strong>
                                    <%= dance.folkloreMaterial.mission.missionNumber %>
                                </strong></li>
                            <li><span>مكان البعثة:</span> <strong>
                                    <%= dance.folkloreMaterial.mission.place %>
                                </strong></li>
                            <% } %>
                                <% if (dance.folkloreMaterial.collector) { %>
                                    <li><span>اسم الجامع:</span> <strong>
                                            <%= dance.folkloreMaterial.collector.name %>
                                        </strong></li>
                                    <% } %>
                    </ul>
                    <% } %>
            </div>

            <div class="sidebar-widget">
                <h3><i class="fa-solid fa-list-check"></i> بيانات الجمع</h3>
                <% if (dance.folkloreMaterial && dance.folkloreMaterial.collectionData) { %>
                    <ul class="widget-list">
                        <li><span>تاريخ الجمع:</span> <strong>
                                <%= dance.folkloreMaterial.collectionData.collectionDate ? new Date(dance.folkloreMaterial.collectionData.collectionDate).toLocaleDateString('ar-EG') : '-' %>
                            </strong></li>
                        <li><span>تاريخ التدوين:</span> <strong>
                                <%= dance.folkloreMaterial.collectionData.documentationDate ? new Date(dance.folkloreMaterial.collectionData.documentationDate).toLocaleDateString('ar-EG') : '-' %>
                            </strong></li>
                        <li><span>المحافظة:</span> <strong>
                                <%= dance.folkloreMaterial.collectionData.collectionPlace?.governorate || '-' %>
                            </strong></li>
                        <li><span>المدينة/المركز:</span> <strong>
                                <%= dance.folkloreMaterial.collectionData.collectionPlace?.city || '-' %>
                            </strong></li>
                        <% if(dance.folkloreMaterial.collectionData.collectionPlace?.village) { %>
                            <li><span>القرية:</span> <strong>
                                    <%= dance.folkloreMaterial.collectionData.collectionPlace.village %>
                                </strong></li>
                        <% } %>
                        <% if(dance.folkloreMaterial.collectionData.collectionCulturePlace) { %>
                            <li><span>البيئة الثقافية:</span> <strong>
                                    <%= dance.folkloreMaterial.collectionData.collectionCulturePlace %>
                                </strong></li>
                        <% } %>
                        <li><span>رقم الأرشيف:</span> <strong>
                                <%= dance.folkloreMaterial.collectionData.archiveNumber %>
                            </strong></li>
                    </ul>
                    <% } else { %>
                        <p class="text-muted">البيانات غير متوفرة</p>
                        <% } %>
            </div>

            <div class="sidebar-widget">
                <h3><i class="fa-solid fa-hard-drive"></i> المصدر الأرشيفي</h3>
                <% if (dance.folkloreMaterial && dance.folkloreMaterial.dataSource) { %>
                    <ul class="widget-list">
                        <li><span>نوع المصدر:</span> <strong>
                                <%= dance.folkloreMaterial.dataSource.sourceType || '-' %>
                            </strong></li>
                        <% if(dance.folkloreMaterial.dataSource.photoNumber) { %>
                            <li><span>رقم الصورة:</span> <strong>
                                    <%= dance.folkloreMaterial.dataSource.photoNumber %>
                                </strong></li>
                            <% } %>
                                <% if(dance.folkloreMaterial.dataSource.tapeNumber) { %>
                                    <li><span>رقم الشريط:</span> <strong>
                                            <%= dance.folkloreMaterial.dataSource.tapeNumber %>
                                        </strong></li>
                                    <% } %>
                                        <% if(dance.folkloreMaterial.dataSource.digitalFileLocation) { %>
                                            <li><span>الملف الرقمي:</span> <strong>
                                                    <%= dance.folkloreMaterial.dataSource.digitalFileLocation %>
                                                </strong></li>
                                            <% } %>
                    </ul>
                    <% } else { %>
                        <p class="text-muted">البيانات غير متوفرة</p>
                        <% } %>
            </div>

            <div class="sidebar-widget action-widget">
                <h3>تحديث البيانات</h3>
                <p>يمكن للباحثين المعتمدين تحديث بيانات هذه المادة.</p>
                <a href="/admin/dance/edit/<%= dance._id %>" class="btn btn-outline" style="width: 100%; display: block; text-align: center;"><i class="fa-solid fa-pen-to-square"></i> تعديل المادة</a>
            </div>
        </div>

    </div>
</div>

<style>
    /* =========================================
       Base & Header Styles (Shared with Mawwal)
       ========================================= */
    .details-header {
        background: linear-gradient(135deg, var(--color-primary-dark), #2a4c7a);
        color: white;
        padding: 60px 0;
        margin-bottom: 30px;
        border-radius: 0 0 30px 30px;
        text-align: center;
    }
    .meta-tags {
        margin-bottom: 20px;
        display: flex;
        justify-content: center;
        gap: 10px;
    }
    .meta-tags .badge {
        background: rgba(255, 255, 255, 0.2);
        padding: 6px 15px;
        border-radius: 20px;
        font-size: 0.9rem;
        backdrop-filter: blur(5px);
    }
    .details-header h1 {
        font-size: 2.5rem;
        margin: 0 0 30px 0;
        font-weight: 700;
        color: white;
    }
    .hero-audio {
        max-width: 600px;
        margin: 0 auto;
        background: rgba(255, 255, 255, 0.1);
        padding: 15px;
        border-radius: 12px;
        backdrop-filter: blur(10px);
    }
    .hero-audio audio {
        width: 100%;
        height: 45px;
        border-radius: 8px;
    }

    /* =========================================
       Grid Layouts
       ========================================= */
    .details-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 30px;
    }
    @media (max-width: 900px) {
        .details-grid {
            grid-template-columns: 1fr;
        }
    }
    .main-content {
        display: flex;
        flex-direction: column;
        gap: 30px;
        min-width: 0;
    }

    /* =========================================
       Content Sections
       ========================================= */
    .content-section {
        background: white;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
        border: 1px solid var(--border-color);
    }
    .content-section h2 {
        color: var(--color-primary-dark);
        font-size: 1.4rem;
        margin-top: 0;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 2px solid var(--bg-light);
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .count-badge {
        background: var(--color-primary-light);
        color: white;
        font-size: 0.9rem;
        padding: 2px 10px;
        border-radius: 20px;
        margin-right: auto;
    }
    
    /* =========================================
       Dance Specific: Video & Images
       ========================================= */
    .main-video-container {
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        background: #000;
    }
    .main-video-container video {
        width: 100%;
        max-height: 450px;
        display: block;
    }
    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 15px;
    }
    .gallery-item {
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        transition: transform 0.3s ease;
    }
    .gallery-item:hover {
        transform: scale(1.02);
    }
    .gallery-item img {
        width: 100%;
        height: 180px;
        object-fit: cover;
        display: block;
    }

    /* =========================================
       Data Grids (Shared)
       ========================================= */
    .text-block p {
        margin: 0;
        line-height: 1.8;
        color: var(--text-color);
        white-space: pre-line;
        word-break: break-word;
        font-size: 1.1rem;
    }
    .data-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
    }
    .data-item {
        background: #fafbfc;
        padding: 15px;
        border-radius: 8px;
        border: 1px solid var(--border-color);
        border-right: 3px solid var(--color-primary-light);
        display: flex;
        flex-direction: column;
        gap: 5px;
        transition: all 0.2s ease;
    }
    .data-item:hover {
        background: #fdfbf7;
    }
    .data-item span {
        font-size: 0.85rem;
        color: var(--text-muted);
    }
    .data-item strong {
        color: var(--color-primary-dark);
        font-size: 1.05rem;
    }

    /* =========================================
       Costumes Cards (Beautiful UI)
       ========================================= */
    .costumes-container {
        display: flex;
        gap: 25px;
        flex-wrap: wrap;
    }
    .costume-card {
        flex: 1;
        min-width: 280px;
        background: white;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        transition: transform 0.2s ease;
    }
    .costume-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.06);
    }
    .costume-header {
        padding: 10px 20px;
        color: white;
        font-weight: bold;
        text-align: center;
    }
    .costume-header.women { background: #e63946; }
    .costume-header.men { background: #1d3557; }
    .costume-image {
        width: 100%;
        height: 200px;
        background: #f1f1f1;
    }
    .costume-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .costume-body {
        padding: 20px;
    }
    .costume-body h3 {
        margin: 0 0 10px 0;
        color: var(--color-primary-dark);
        font-size: 1.2rem;
    }
    .costume-body p {
        margin: 0;
        color: var(--text-color);
        line-height: 1.6;
        font-size: 0.95rem;
    }

    /* =========================================
       Performers List (Sleek List)
       ========================================= */
    .performers-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }
    .performer-card {
        display: flex;
        align-items: center;
        gap: 20px;
        background: #fafbfc;
        padding: 20px;
        border-radius: 12px;
        border: 1px solid var(--border-color);
        transition: background 0.2s ease;
    }
    .performer-card:hover { background: white; box-shadow: 0 4px 15px rgba(0,0,0,0.04); }
    .performer-avatar {
        width: 60px;
        height: 60px;
        background: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        border: 2px solid var(--border-color);
        flex-shrink: 0;
    }
    .performer-details { flex: 1; }
    .performer-details h4 {
        margin: 0 0 8px 0;
        color: var(--color-primary-dark);
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .gender-tag {
        font-size: 0.75rem;
        background: var(--bg-light);
        padding: 2px 8px;
        border-radius: 12px;
        color: var(--text-muted);
    }
    .performer-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        font-size: 0.9rem;
        color: var(--text-color);
    }
    .performer-meta span i {
        color: var(--color-primary);
        margin-left: 5px;
    }

    /* =========================================
       Tools Cards (Grid)
       ========================================= */
    .tools-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 25px;
    }
    .tool-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        display: flex;
        flex-direction: column;
    }
    .tool-image {
        width: 100%;
        height: 180px;
        background: #f1f1f1;
    }
    .tool-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .tool-body {
        padding: 20px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }
    .tool-body h3 {
        margin: 0 0 10px 0;
        color: var(--color-primary-dark);
        font-size: 1.2rem;
    }
    .tool-body p {
        margin: 0 0 20px 0;
        color: var(--text-color);
        line-height: 1.6;
        font-size: 0.95rem;
        flex: 1;
    }
    .tool-video-btn {
        width: 100%;
        text-align: center;
        font-size: 0.9rem;
        padding: 8px;
    }

    /* =========================================
       Sidebar
       ========================================= */
    .sidebar {
        display: flex;
        flex-direction: column;
        gap: 20px;
        min-width: 0;
    }
    .sidebar-widget {
        background: white;
        border-radius: 12px;
        padding: 25px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
    }
    .sidebar-widget h3 {
        font-size: 1.1rem;
        color: var(--color-primary-dark);
        margin-top: 0;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        gap: 8px;

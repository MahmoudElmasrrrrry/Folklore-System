<div class="page-header">
    <h1>إضافة تفاصيل الموال</h1>
    <p>يرجى استكمال البيانات التفصيلية الخاصة بعنصر الموال</p>
</div>

<form id="mawwalForm" action="/mawwal/add" method="POST">
    <!-- ربط الموال بالمادة الفلكلورية الأساسية -->
    <input type="hidden" name="folkloreMaterial" value="<%= folkloreId %>">

    <!-- 1. بيانات الموال -->
    <div class="form-section">
        <h2 class="form-section-title"><i class="fa-solid fa-file-signature"></i> 1. بيانات الموال</h2>
        <div class="form-row">
            <div class="form-group">
                <label>اسم الموال <span class="required">*</span></label>
                <input type="text" name="mawwalName" class="form-control" required placeholder="مثال: موال أدهم الشرقاوي">
            </div>
            <div class="form-group">
                <label>نوع الموال <span class="required">*</span></label>
                <select name="mawwalType" class="form-control" required>
                    <option value="">اختر النوع</option>
                    <option>قصصي</option>
                    <option>غنائي</option>
                </select>
            </div>
            <div class="form-group">
                <label>التصنيف الموضوعي (افصل بـ -)</label>
                <input type="text" name="thematicClassification" class="form-control" placeholder="بطولة - متعدد القيم">
            </div>
        </div>
    </div>

    <!-- 2. النص والمحتوى -->
    <div class="form-section">
        <h2 class="form-section-title"><i class="fa-solid fa-align-right"></i> 2. النص والمحتوى</h2>
        <div class="form-group">
            <label>النص الكامل <span class="required">*</span></label>
            <textarea name="fullText" class="form-control" required rows="5" placeholder="اكتب نص الموال هنا..."></textarea>
        </div>
        <div class="form-row" style="margin-top: 15px;">
            <div class="form-group">
                <label>المدة (رقم)</label>
                <input type="number" name="durationValue" class="form-control" min="1">
            </div>
            <div class="form-group">
                <label>وحدة المدة</label>
                <select name="durationUnit" class="form-control">
                    <option value="">اختر الوحدة</option>
                    <option>ساعة</option>
                    <option>دقائق</option>
                    <option>ثواني</option>
                </select>
            </div>
            <div class="form-group">
                <label>عدد الأبيات</label>
                <input type="number" name="linesCount" class="form-control" min="4" max="300">
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>نمط الأداء</label>
                <select name="performanceMode" class="form-control">
                    <option value="">اختر النمط</option>
                    <option>مغني مصاحب آلات </option>
                    <option>مغني بدون آلات </option>
                    <option>سرد</option>
                </select>
            </div>
            <div class="form-group">
                <label>اللهجة</label>
                <select name="dialect" class="form-control">
                    <option value="">اختر اللهجة</option>
                    <option>صعيدي</option>
                    <option>بدوي</option>
                </select>
            </div>
        </div>
        <div class="form-group" style="margin-top: 15px;">
            <label>ملخص الأحداث</label>
            <textarea name="eventsSummary" class="form-control" rows="3" placeholder="ملخص قصير للأحداث..."></textarea>
        </div>
    </div>

    <!-- 3. سرد الموال -->
    <div class="form-section">
        <h2 class="form-section-title"><i class="fa-solid fa-book-open"></i> 3. سرد الموال</h2>
        <div class="form-row">
            <div class="form-group">
                <label>زمن القص</label>
                <select name="narrationTime" class="form-control">
                    <option value="">اختر الزمن</option>
                    <option>قديم</option>
                    <option>غير محدد</option>
                </select>
            </div>
            <div class="form-group">
                <label>المنسابة</label>
                <select name="narrationPlace" class="form-control">
                    <option value="">اختر المكان</option>
                    <option>عرس</option>
                    <option>موالد</option>
                </select>
            </div>
            <div class="form-group">
                <label>أسلوب السرد</label>
                <select name="narrativeStyle" class="form-control">
                    <option value="">اختر الأسلوب</option>
                    <option>وصفي</option>
                    <option>حواري</option>
                </select>
            </div>
        </div>
    </div>

    <!-- 4. الدلالات الثقافية والاجتماعية -->
    <div class="form-section">
        <h2 class="form-section-title"><i class="fa-solid fa-people-arrows"></i> 4. الدلالات الثقافية والاجتماعية</h2>
        <div class="form-row">
            <div class="form-group">
                <label>الوظيفة الاجتماعية (افصل بـ -)</label>
                <input type="text" name="socialFunction" class="form-control" placeholder="تسلية - وعظ">
            </div>
            <div class="form-group">
                <label>القيم المعكوسة (افصل بـ -)</label>
                <input type="text" name="reflectedValues" class="form-control" placeholder="الكرم - الشجاعة">
            </div>
        </div>
    </div>

    <!-- 5. الأداء والتداول -->
    <div class="form-section">
        <h2 class="form-section-title"><i class="fa-solid fa-music"></i> 5. الأداء والممارسة</h2>
        <div class="form-row">
            <div class="form-group">
                <label>المناسبة (افصل بـ -)</label>
                <input type="text" name="occasion" class="form-control" placeholder="فرح - سيرة">
            </div>
            <div class="form-group">
                <label>طريقة الأداء</label>
                <select name="performanceMethod" class="form-control">
                    <option value="">اختر الطريقة</option>
                    <option>فردي</option>
                    <option>جماعي</option>
                </select>
            </div>
            <div class="form-group">
                <label>البحر العروضي</label>
                <select name="prosodicMeter" class="form-control">
                    <option value="">اختر البحر</option>
                    <option>أعرج</option>
                    <option>هزج</option>
                </select>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>اسم المقام الموسيقي</label>
                <input type="text" name="maqamName" class="form-control">
            </div>
            <div class="form-group">
                <label>الآلات المرافقة (افصل بـ -)</label>
                <input type="text" name="accompanyingInstruments" class="form-control" placeholder="ربابة - مزمار">
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>رفع ملف صوتي للموال</label>
                <input type="file" name="audioFile" class="form-control" accept="audio/*" style="padding: 5px;">
            </div>
        </div>
        <div class="form-group" style="margin-top: 15px;">
            <label>تقديم الموال</label>
            <textarea name="mawwalPresentation" class="form-control" rows="2"></textarea>
        </div>
    </div>

    <!-- 6. وصف العنصر -->
    <div class="form-section">
        <h2 class="form-section-title"><i class="fa-solid fa-info-circle"></i> 6. وصف العنصر</h2>
        <div class="form-group">
            <label>وصف العنصر الفلكلوري (حد أقصى 300 كلمة) <span id="word-count" style="float:left; font-size: 0.9em; color: var(--color-primary);">0 / 300</span></label>
            <textarea name="elementDescription" id="elementDescription" class="form-control" rows="3"></textarea>
        </div>
        <div class="form-group" style="margin-top: 15px;">
            <label>سياق الممارسة</label>
            <textarea name="practiceContext" class="form-control" rows="2"></textarea>
        </div>
    </div>

    <!-- 7. الملاحظات والتعليقات -->
    <div class="form-section">
        <h2 class="form-section-title"><i class="fa-solid fa-clipboard"></i> 8. الملاحظات والتعليقات</h2>
        <div class="form-row">
            <div class="form-group">
                <label>الانتشار الجغرافي</label>
                <input type="text" name="geographicSpread" class="form-control">
            </div>
            <div class="form-group">
                <label>طرق الانتقال (افصل بـ -)</label>
                <input type="text" name="transmissionMethods" class="form-control" placeholder="شفاهي - مكتوب">
            </div>
        </div>
        <div class="form-group" style="margin-top: 15px;">
            <label>ملاحظات الباحث</label>
            <textarea name="researcherNotes" class="form-control" rows="3"></textarea>
        </div>
    </div>

    <!-- 8. خصائص أخرى -->
    <div class="form-section">
        <h2 class="form-section-title"><i class="fa-solid fa-star"></i> 9. خصائص العنصر</h2>
        <div class="form-group">
            <label>الوضع الحالي للعنصر</label>
            <input type="text" name="currentStatus" class="form-control" placeholder="مستمر - مهدد بالانقراض">
        </div>
    </div>

    <div style="text-align: left; margin-bottom: 40px;">
        <button type="submit" class="btn btn-primary btn-lg" style="padding: 15px 40px; font-size: 1.1rem;"><i class="fa-solid fa-save"></i> حفظ جميع تفاصيل الموال بشكل نهائي</button>
    </div>

</form>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const descInput = document.getElementById("elementDescription");
        const countDisplay = document.getElementById("word-count");
        
        if (descInput && countDisplay) {
            // Function to update count
            const updateCount = function() {
                const text = descInput.value.trim();
                const words = text ? text.split(/\s+/) : [];
                let wordCount = words.length;
                
                if (wordCount > 300) {
                    descInput.value = words.slice(0, 300).join(" ");
                    wordCount = 300;
                    countDisplay.style.color = "red";
                } else {
                    countDisplay.style.color = "var(--color-primary)";
                }
                
                countDisplay.innerText = `${wordCount} / 300`;
            };

            descInput.addEventListener("input", updateCount);
            // Run once on load if there's pre-filled data
            updateCount();
        }
    });
</script>

